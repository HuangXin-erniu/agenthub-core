{
  "schema_version": 1,
  "project_id": "<project_id>",
  "devices": {
    "<authority_device_id>": {
      "kind": "execution_host",
      "project_access": "local"
    },
    "<client_device_id>": {
      "kind": "client",
      "project_access": "ssh_to_authority"
    }
  },
  "agents": {
    "<administrator_agent_id>": {
      "enabled": true,
      "roles": [
        "administrator",
        "decider"
      ],
      "devices": [
        "<client_device_id>"
      ]
    },
    "<decider_agent_id>": {
      "enabled": true,
      "roles": [
        "decider"
      ],
      "devices": [
        "<client_device_id>"
      ]
    },
    "<executor_agent_id>": {
      "enabled": true,
      "roles": [
        "executor"
      ],
      "devices": [
        "<authority_device_id>",
        "<client_device_id>"
      ]
    }
  },
  "state_authority": {
    "host": "<authority_device_id>",
    "database": "<authority-local-state-path>",
    "policy": "single_authority_local"
  },
  "execution": {
    "repository": "<authority-project-root>",
    "worktree_root": "<authority-worktree-root>",
    "artifact_root": "<authority-artifact-root>",
    "max_active_tasks_per_executor": 1,
    "max_contract_bytes": 16384,
    "session_policy": "optional"
  },
  "remote": {
    "enabled": true,
    "shell": "posix_sh",
    "ssh_host": "<ssh-config-alias>",
    "project_root": "<authority-project-root>",
    "launcher": "<launcher-file>",
    "ssh_options": [
      "BatchMode=yes",
      "StrictHostKeyChecking=yes",
      "ConnectTimeout=10",
      "ServerAliveInterval=15",
      "ServerAliveCountMax=2"
    ]
  },
  "instructions": {
    "common": "AGENTS.md",
    "<administrator_agent_id>": "<administrator-role-file>",
    "<decider_agent_id>": "<decider-role-file>",
    "<executor_agent_id>": "<executor-role-file>"
  },
  "deployment": {
    "adapter": "ssh_atomic_posix",
    "managed_files": [
      {
        "source": "../../agent_hub.py",
        "destination": "<runtime-destination>"
      },
      {
        "source": "project.json",
        "destination": "<config-destination>"
      },
      {
        "source": "<launcher-file>",
        "destination": "<launcher-file>"
      },
      {
        "source": "AGENTS.md",
        "destination": "AGENTS.md"
      }
    ]
  },
  "task_naming": {
    "task_pattern": "TASK-(?P<seq>\\d{3})",
    "chain_pattern": "CHAIN-(?P<seq>\\d{4})",
    "seq_digits": 3
  }
}
